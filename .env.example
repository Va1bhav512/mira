# Qdrant Cloud Configuration
# Get your credentials from: https://cloud.qdrant.io/
QDRANT_CLUSTER_ENDPOINT=your_qdrant_endpoint_here
QDRANT_CLUSTER_API_KEY=your_qdrant_api_key_here

# Example:
# QDRANT_CLUSTER_ENDPOINT=https://xxx-xxx.sa-east-1-0.aws.cloud.qdrant.io
# QDRANT_CLUSTER_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
